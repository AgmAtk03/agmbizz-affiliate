---
import ArticleCard from '../components/ArticleCard.astro';
import EmailCapture from '../components/EmailCapture.astro';
import PillarCard from '../components/PillarCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getArticlesForPillar,
  getPublishedArticles,
  getPublishedPillars,
} from '../lib/collections';
import { organizationJsonLd, webSiteJsonLd } from '../lib/jsonld';
import { homeCrumb, paths } from '../lib/paths';
import { site } from '../lib/site';

const pillars = await getPublishedPillars();
const articles = await getPublishedArticles();
const latest = articles.slice(0, 4);
const pillarsWithArticles = await Promise.all(
  pillars.map(async (pillar) => ({
    pillar,
    articles: await getArticlesForPillar(pillar.data.slug),
  })),
);

const crumbs = [homeCrumb()];
---

<BaseLayout
  title={`${site.name} — ${site.tagline}`}
  description={site.description}
  path={paths.home}
  crumbs={crumbs}
  jsonLd={[organizationJsonLd(), webSiteJsonLd()]}
>
  <header class="border-b border-rule pb-10">
    <p class="text-[0.7rem] font-semibold tracking-[0.2em] text-accent uppercase">
      Field journal · {site.niche}
    </p>
    <h1 class="mt-3 max-w-3xl font-serif text-4xl leading-[1.15] tracking-tight sm:text-5xl">
      Editorial infrastructure for {site.niche}, ready for a real category.
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-ink-soft">
      {site.name} is a {site.publication} publication. The guides below are commercial-intent
      <em>stubs</em> so the team can prove information architecture, metadata, and affiliate markup
      before anyone picks a niche.
    </p>
  </header>

  <section class="mt-10" aria-labelledby="pillars-heading">
    <div class="flex items-end justify-between gap-4">
      <h2 id="pillars-heading" class="font-serif text-3xl">Three pillars</h2>
      <a class="text-sm font-semibold text-accent hover:text-accent-deep" href={paths.guides}>
        All guides
      </a>
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {pillarsWithArticles.map(({ pillar, articles: pillarArticles }) => (
        <PillarCard pillar={pillar} articles={pillarArticles} />
      ))}
    </div>
  </section>

  <section class="mt-14" aria-labelledby="latest-heading">
    <h2 id="latest-heading" class="font-serif text-3xl">Latest stubs</h2>
    <div class="mt-4">
      {latest.map((article) => {
        const pillar = pillars.find((entry) => entry.data.slug === article.data.pillar);
        return <ArticleCard article={article} pillar={pillar} />;
      })}
    </div>
  </section>

  <div class="mt-12">
    <EmailCapture />
  </div>
</BaseLayout>
