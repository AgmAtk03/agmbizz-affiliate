---
import { getFormAction, site } from '../lib/site';

interface Props {
  heading?: string;
  lede?: string;
}

const {
  heading = `Field notes for ${site.niche}`,
  lede = 'Placeholder list. Wire PUBLIC_FORM_ACTION to Formspree (or similar) when you are ready to collect addresses. No database ships with this scaffold.',
} = Astro.props;

const action = getFormAction();
---

<aside class="border border-rule bg-paper-deep/70 px-5 py-6">
  <h2 class="font-serif text-2xl leading-tight">{heading}</h2>
  <p class="mt-2 text-sm text-ink-soft">{lede}</p>

  <form
    id="email-capture"
    class="mt-4 flex flex-col gap-3 sm:flex-row"
    method="post"
    action={action ?? '#'}
    data-mode={action ? 'remote' : 'placeholder'}
  >
    <label class="sr-only" for="email-capture-input">Email address</label>
    <input
      id="email-capture-input"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
      class="min-w-0 flex-1 border border-rule bg-paper px-3 py-2 text-base text-ink placeholder:text-ink-soft/70"
    />
    <button
      type="submit"
      class="bg-ink px-4 py-2 text-sm font-semibold tracking-wide text-paper uppercase hover:bg-moss"
    >
      Join the list
    </button>
  </form>

  <p id="email-capture-status" class="mt-3 text-sm text-ink-soft" role="status" aria-live="polite"></p>
</aside>

<script>
  const form = document.getElementById('email-capture');
  const status = document.getElementById('email-capture-status');
  if (form instanceof HTMLFormElement && status) {
    form.addEventListener('submit', async (event) => {
      const mode = form.dataset.mode;
      if (mode === 'placeholder') {
        event.preventDefault();
        status.textContent =
          'Captured locally only. Set PUBLIC_FORM_ACTION to a Formspree (or similar) endpoint to collect emails.';
        form.reset();
        return;
      }

      event.preventDefault();
      status.textContent = 'Sending…';
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error('Request failed');
        status.textContent = 'Thanks — you are on the placeholder list.';
        form.reset();
      } catch {
        status.textContent = 'Something went wrong. Try again, or email the editors from the contact page.';
      }
    });
  }
</script>
