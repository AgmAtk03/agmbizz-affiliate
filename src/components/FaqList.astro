---
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<section class="mt-12 border-t border-rule pt-8">
  <h2 class="font-serif text-2xl">Frequently asked</h2>
  <dl class="mt-4 space-y-5">
    {items.map((item) => (
      <div>
        <dt class="font-semibold">{item.question}</dt>
        <dd class="mt-1 text-ink-soft">{item.answer}</dd>
      </div>
    ))}
  </dl>
</section>
